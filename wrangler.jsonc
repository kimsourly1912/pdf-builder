{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdf-builder",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://pdf-builder.kimsur61.workers.dev",
    "MANAGEMENT_EMAIL": "kimsur61@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdf-builder-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pdf-builder-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_FIELD_DETECTION_QUEUE",
        "queue": "pdf-builder-ai-field-detection"
      }
    ],
    "consumers": [
      {
        "queue": "pdf-builder-ai-field-detection",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
